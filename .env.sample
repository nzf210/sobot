# Solana Network Configuration
RPC_URL=https://api.mainnet-beta.solana.com
WSS_URL=wss://api.mainnet-beta.solana.com

# Wallet Configuration
# Password to decrypt the wallet and path to the encrypted file
WALLET_PASSWORD=your_secure_password
WALLET_PATH=executor-ts/wallet.enc

# Data Directory (JSON file store for positions, decisions, lessons)
DATA_DIR=./data/memory

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID is kept for backward compatibility, but you can also use:
TELEGRAM_WHITELIST_USER_IDS=your_telegram_chat_id_here,another_id_here

# LLM Configuration
LLM_API_KEY=your_openai_or_anthropic_api_key
LLM_MODEL=gpt-4o-mini
LLM_URL=https://api.openai.com/v1 # Or custom endpoint for local/alternative LLMs

# API Server Configuration
BACKEND_PORT=8089
EXECUTOR_PORT=3009
EXECUTOR_API_KEY=change-me-to-a-random-secret

# BTC Treasury Configuration
# Binance Spot API key and secret (required for trading)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BTC_TREASURY_PORT=8090

# BTC Telegram bot (separate from Solana bot — different token to keep scopes clean)
TELEGRAM_BOT_BTC_TOKEN=your_btc_treasury_telegram_bot_token
TELEGRAM_WHITELIST_USER_BTC_IDS=your_telegram_chat_id_here
TELEGRAM_REPORT_CHAT_IDS=your_telegram_chat_id_here

# BTC scanner: which pairs to scan. Comma-separated Binance BTC-quote pairs
# (e.g. ETHBTC, SOLBTC, SUIBTC). These are what the bot actually trades for
# BTC accumulation. BTCUSDT is the price reference, not a trade pair.
BTC_SCANNER_PAIRS=ETHBTC,SOLBTC,SUIBTC,LINKBTC
BTC_SCANNER_INTERVAL_SECS=900
BTC_REPORT_INTERVAL_MINS=5
